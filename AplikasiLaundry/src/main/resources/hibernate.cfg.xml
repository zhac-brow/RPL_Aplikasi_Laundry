<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE hibernate-configuration PUBLIC
        "-//Hibernate/Hibernate Configuration DTD 3.0//EN"
        "http://www.hibernate.org/dtd/hibernate-configuration-3.0.dtd">
<hibernate-configuration>
    <session-factory>
        <!-- Koneksi database (URL, username, password) diatur di applicationContext.xml -->
        <property name="hibernate.dialect">org.hibernate.dialect.MySQL8Dialect</property>
        <property name="hibernate.show_sql">true</property>
        <property name="hibernate.hbm2ddl.auto">none</property>

        <!-- Daftar class model (entity) -->
        <mapping class="com.mycompany.laundry.model.User"/>
        <mapping class="com.mycompany.laundry.model.Pelanggan"/>
        <mapping class="com.mycompany.laundry.model.Layanan"/>
        <mapping class="com.mycompany.laundry.model.Transaksi"/>
        <mapping class="com.mycompany.laundry.model.Stok"/>
    </session-factory>
</hibernate-configuration>
